# Copy to backend/.env and replace every placeholder with locally generated values.
# Never commit backend/.env or use these placeholders as live credentials.
DATABASE_URL=postgresql://sauti_yetu:change-me@localhost:5432/sauti_yetu_dev
DATABASE_SSL=false
# Optional in development; production migrations require a separate privileged role.
# MIGRATION_DATABASE_URL=postgresql://sauti_yetu_migrator:change-me@localhost:5432/sauti_yetu_dev
PORT=4000
NODE_ENV=development
TRUST_PROXY=false
CONSENT_NOTICE_VERSION=2026-11-v1

# Generate with: openssl rand -base64 32
GUARDIAN_PHONE_ENCRYPTION_KEY_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY

# Generate independent random values; each must contain at least 32 characters.
GUARDIAN_PHONE_LOOKUP_PEPPER=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
AUDIT_FINGERPRINT_PEPPER=REPLACE_WITH_ANOTHER_INDEPENDENT_RANDOM_SECRET
GUARDIAN_OTP_PEPPER=REPLACE_WITH_A_THIRD_INDEPENDENT_RANDOM_SECRET

# Optional: configure an HTTPS SMS relay implementing the documented Sauti Yetu
# gateway contract. Without both values, OTP endpoints fail closed with HTTP 503.
# SMS_GATEWAY_URL=https://your-approved-sms-relay.example/api/messages
# SMS_GATEWAY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
